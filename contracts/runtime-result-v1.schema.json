{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keeptoy.github.io/pwf-codex-cloud-hooks/contracts/runtime-result-v1.schema.json",
  "title": "planning-with-files owned runtime result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "inject",
    "report",
    "warnings",
    "diagnostic"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "inject": {
      "type": "boolean"
    },
    "report": {
      "type": ["string", "null"],
      "maxLength": 20000
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "transcript_path_rejected",
          "scan_fallback_used",
          "unknown_transcript_record",
          "duplicate_record_suppressed",
          "invalid_utf8_record",
          "invalid_json_record",
          "record_too_large",
          "report_truncated"
        ]
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_name", "session_id_present", "planning_enabled", "session_attachment", "selected_transcript", "selected_transcript_path", "selected_plan_scope", "selected_plan_dir"],
      "properties": {
        "event_name": {
          "enum": ["SessionStart", "UserPromptSubmit"]
        },
        "session_id_present": {
          "type": "boolean"
        },
        "planning_enabled": {
          "type": "boolean"
        },
        "session_attachment": {
          "enum": ["legacy", "attached", "detached"]
        },
        "selected_transcript": {
          "enum": ["none", "host_path", "session_store_fallback"]
        },
        "selected_transcript_path": {
          "type": ["string", "null"],
          "maxLength": 4096
        },
        "selected_plan_scope": {
          "enum": ["none", "scoped", "legacy_root"]
        },
        "selected_plan_dir": {
          "type": ["string", "null"],
          "maxLength": 4096
        }
      }
    }
  },
  "$defs": {
    "outcome": {
      "enum": [
        "report_emitted",
        "diagnostic_report_available",
        "planning_disabled",
        "session_not_attached",
        "no_plan",
        "invalid_request",
        "transcript_path_rejected",
        "no_session_store",
        "no_matching_session",
        "session_identity_mismatch",
        "no_planning_update",
        "no_unsynced_context",
        "output_budget_exceeded",
        "malformed_transcript",
        "transcript_unreadable",
        "timeout",
        "runtime_error"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "report_emitted" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "inject": { "const": true },
          "report": { "type": "string", "minLength": 1, "maxLength": 20000 }
        }
      },
      "else": {
        "properties": {
          "inject": { "const": false },
          "report": { "type": "null" }
        }
      }
    }
  ]
}
